---
import { getCollection } from 'astro:content';
import WritingList from '../../components/WritingList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const essays = (await getCollection('essays')).filter((entry) => !entry.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const travel = (await getCollection('travel')).filter((entry) => !entry.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const allWriting = [...essays, ...travel].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing — Karl Nicholson" description="Site under construction.">
  <div class="page-shell">
    <h1 class="visually-hidden">Writing</h1>

    <div class="writing-groups">
      <section class="writing-group" aria-labelledby="essays-group-title">
        <h2 id="essays-group-title">Musings</h2>
        <p>Site under construction.</p>
        <a class="text-link" href="/writing/essays/">Browse {essays.length} {essays.length === 1 ? 'entry' : 'entries'} →</a>
      </section>
      <section class="writing-group" aria-labelledby="travel-group-title">
        <h2 id="travel-group-title">Gach áit eile</h2>
        <p>Site under construction.</p>
        <a class="text-link" href="/writing/travel/">Browse {travel.length} {travel.length === 1 ? 'entry' : 'entries'} →</a>
      </section>
    </div>

    <WritingList entries={allWriting} />
  </div>
</BaseLayout>
