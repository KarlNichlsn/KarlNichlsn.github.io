---
import { getCollection } from 'astro:content';
import Timeline from '../components/Timeline.astro';
import WritingList from '../components/WritingList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const writing = [
  ...(await getCollection('essays')).filter((entry) => !entry.data.draft),
  ...(await getCollection('travel')).filter((entry) => !entry.data.draft),
]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero__copy">
      <p class="eyebrow">Physics · Data-intensive science · Writing</p>
      <h1 id="home-title">Karl Nicholson</h1>
      <p class="hero__introduction">
        I work across physics, machine learning and scientific computing, with an interest in how
        technical ideas become useful research, systems and stories.
      </p>
      <div class="hero__links">
        <a class="button-link" href="/about/">About me</a>
        <a class="button-link" href="/cv/">View CV</a>
      </div>
    </div>

    <!-- Static visual foundation only. The final interactive hero will replace this in a later pass. -->
    <div class="hero__foundation" aria-hidden="true"></div>
  </section>

  <section class="section section--surface" aria-labelledby="focus-title">
    <div class="section-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Current focus</p>
          <h2 id="focus-title">From physical systems to data-intensive questions.</h2>
        </div>
        <div>
          <p>
            My background spans physics and astrophysics, scientific research, autonomous systems,
            applied AI and teaching. I am currently studying Data Intensive Science at the University
            of Cambridge.
          </p>
          <a class="text-link" href="/about/">Read the longer biography →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-title">
    <div class="section-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Timeline</p>
          <h2 id="timeline-title">A life branching outward.</h2>
        </div>
        <div>
          <p>
            Academic and professional work sits alongside the interests, communities and activities
            that shaped it. This first implementation prioritises chronology and readable content;
            motion will be refined later.
          </p>
        </div>
      </div>
      <Timeline />
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="projects-title">
    <div class="section-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected projects</p>
          <h2 id="projects-title">Research and engineering in context.</h2>
        </div>
        <div>
          <p>A small selection of work across astrophysics, autonomous systems and radio astronomy.</p>
        </div>
      </div>

      <ol class="project-list">
        {projects.map((project) => (
          <li>
            <article class="project-card">
              <p class="project-card__meta">{project.data.period}<br />{project.data.role}</p>
              <div>
                <h2><a href={`/projects/${project.id}/`}>{project.data.title}</a></h2>
                <p>{project.data.description}</p>
              </div>
            </article>
          </li>
        ))}
      </ol>
      <p class="section-cta"><a class="text-link" href="/projects/">All projects →</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-title">
    <div class="section-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Writing</p>
          <h2 id="writing-title">Essays, field notes and travel.</h2>
        </div>
        <div>
          <p>Repository-published writing, organised as essays and geographically structured travel notes.</p>
        </div>
      </div>
      <WritingList entries={writing} compact />
      <p class="section-cta"><a class="text-link" href="/writing/">Browse all writing →</a></p>
    </div>
  </section>
</BaseLayout>
