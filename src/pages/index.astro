---
import { getCollection } from 'astro:content';
import AtmosphericHero from '../components/AtmosphericHero.astro';
import Timeline from '../components/Timeline.astro';
import WritingList from '../components/WritingList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const writing = [
  ...(await getCollection('essays')).filter((entry) => !entry.data.draft),
  ...(await getCollection('travel')).filter((entry) => !entry.data.draft),
]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <div class="landing">
    <AtmosphericHero />

    <section class="hero" aria-labelledby="home-title">
      <div class="hero__copy">
        <p class="eyebrow">Physics · Data-intensive science · Writing</p>
        <h1 id="home-title">Karl Nicholson</h1>
        <p class="hero__introduction">Welcome! My name is Karl and I studied Physics &amp; Astrophysics @ Trinity College Dublin. Have a look around my site to see some of the things I've done.</p>
        <div class="hero__links">
          <a class="button-link" href="/about/">About me</a>
          <a class="button-link" href="/cv/">View CV</a>
        </div>
        <p class="hero__desktop-note">This site is best viewed on desktop</p>
      </div>
    </section>
  </div>

  <section class="section section--timeline" aria-label="Life timeline">
    <div class="section-inner">
      <Timeline />
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="projects-title">
    <div class="section-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected projects</p>
          <h2 id="projects-title">Research and engineering in context.</h2>
        </div>
        <div>
          <p>Site under construction.</p>
        </div>
      </div>

      <ol class="project-list">
        {projects.map((project) => (
          <li>
            <article class="project-card">
              <p class="project-card__meta">{project.data.period}<br />{project.data.role}</p>
              <div>
                <h2><a href={`/projects/${project.id}/`}>{project.data.title}</a></h2>
                <p>{project.data.description}</p>
              </div>
            </article>
          </li>
        ))}
      </ol>
      <p class="section-cta"><a class="text-link" href="/projects/">All projects →</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-title">
    <div class="section-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Writing</p>
          <h2 id="writing-title">Essays, field notes and travel.</h2>
        </div>
        <div>
          <p>Site under construction.</p>
        </div>
      </div>
      <WritingList entries={writing} compact />
      <p class="section-cta"><a class="text-link" href="/writing/">Browse all writing →</a></p>
    </div>
  </section>
</BaseLayout>
