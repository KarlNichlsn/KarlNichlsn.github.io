---
import { getCollection } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects — Karl Nicholson" description="Site under construction.">
  <div class="page-shell">
    <PageHeader
      eyebrow="Projects"
      title="A considered selection of work."
      introduction="Site under construction."
    />

    <ol class="project-list">
      {projects.map((project) => (
        <li>
          <article class="project-card">
            <p class="project-card__meta">{project.data.period}<br />{project.data.role}</p>
            <div>
              <h2><a href={`/projects/${project.id}/`}>{project.data.title}</a></h2>
              <p>{project.data.description}</p>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
