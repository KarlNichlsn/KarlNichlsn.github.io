<button
  class="theme-toggle"
  type="button"
  aria-label="Switch to night mode"
  aria-pressed="false"
  data-theme-toggle
>
  <span class="theme-toggle__track" aria-hidden="true">
    <svg class="theme-toggle__icon" viewBox="0 0 24 24">
      <g class="theme-toggle__sun">
        <circle cx="12" cy="12" r="3.35"></circle>
        <path d="M12 2.25v2.1M12 19.65v2.1M4.2 4.2l1.5 1.5M18.3 18.3l1.5 1.5M2.25 12h2.1M19.65 12h2.1M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5"></path>
      </g>
      <path
        class="theme-toggle__moon"
        d="M18.2 15.45A7.25 7.25 0 0 1 8.55 5.8a7.25 7.25 0 1 0 9.65 9.65Z"
      ></path>
    </svg>
  </span>
</button>

<script>
  const initialiseThemeToggles = () => {
    const root = document.documentElement;
    const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

    const updateControls = (theme: 'day' | 'night') => {
      const isNight = theme === 'night';
      toggles.forEach((toggle) => {
        toggle.setAttribute('aria-pressed', String(isNight));
        toggle.setAttribute('aria-label', isNight ? 'Switch to day mode' : 'Switch to night mode');
      });

      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      themeColor?.setAttribute('content', isNight ? '#1B1815' : '#F1EADF');
    };

    const currentTheme = root.dataset.theme === 'night' ? 'night' : 'day';
    updateControls(currentTheme);

    toggles.forEach((toggle) => {
      if (toggle.dataset.themeReady === 'true') return;
      toggle.dataset.themeReady = 'true';
      toggle.addEventListener('click', () => {
        const nextTheme = root.dataset.theme === 'night' ? 'day' : 'night';
        root.dataset.theme = nextTheme;
        try {
          localStorage.setItem('karl-theme', nextTheme);
        } catch {
          // The visual state still changes when storage is unavailable.
        }
        updateControls(nextTheme);
      });
    });
  };

  initialiseThemeToggles();
  document.addEventListener('astro:after-swap', initialiseThemeToggles);
</script>
