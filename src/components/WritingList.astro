---
import type { CollectionEntry } from 'astro:content';

type WritingEntry = CollectionEntry<'essays'> | CollectionEntry<'travel'>;

interface Props {
  entries: WritingEntry[];
  compact?: boolean;
}

const { entries, compact = false } = Astro.props;

const entryHref = (entry: WritingEntry) =>
  entry.collection === 'travel'
    ? `/writing/travel/${entry.id}/`
    : `/writing/essays/${entry.id}/`;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<ol class:list={['writing-list', { 'writing-list--compact': compact }]}>
  {entries.map((entry) => (
    <li>
      <article>
        <p class="writing-list__meta">
          <span>{entry.collection === 'travel' ? 'Travel' : 'Essay'}</span>
          <time datetime={entry.data.date.toISOString()}>{dateFormatter.format(entry.data.date)}</time>
        </p>
        <h3><a href={entryHref(entry)}>{entry.data.title}</a></h3>
        <p>{entry.data.description}</p>
      </article>
    </li>
  ))}
</ol>
